<!-- 
Template for single operation response.

Available variables:
- code: string;
- description: string; // pre-rendered HTML
- content: string; // pre-rendered HTML
-->
<div class="operation-response">
    <div class="operation-response-header">
        <div class="operation-response-code">{{code}}</div>
        <div class="operation-response-description">
            {{{description}}}
        </div>
    </div>
    <div class="operation-response-content">
        {{{content}}}
    </div>
</div>

<!-- 
Template for render a single "content type" in an operation response.
Available variables:
- status: http status code
- contentType: string;
- content: pre-rendered HTML description of the content type;
-->

<div class="operation-response-content-type">
    <div class="operation-response-content-type-content-type">Content-type: {{contentType}}</div>
    <div class="operation-response-content-type-content">
        {{{content}}}
    </div>
</div>

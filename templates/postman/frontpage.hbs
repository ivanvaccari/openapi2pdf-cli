<!-- 
front page template.

Available variables:
- metadata: the full object from the "metadata" field in the config file
- openApiSpecJson: the full OpenAPI spec as a JSON object.

This is the first page of the generated PDF. After this page, the "revisions" page is rendered.
-->

<div class='front-page'>
    
    <h1>{{ metadata.info.title}}</h1>

    <div class="description">
        {{ metadata.info.description}}
    </div>

    <div class="current-version">
        Version {{ metadata.info.version}}
    </div>
</div>

<!-- jsreport page break. See https://jsreport.net/blog/pdf-report-paging-and-page-breaks -->
<div class="page-break"></div>
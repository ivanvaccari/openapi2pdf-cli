<!-- 
Template for the Table of Contents section.
    
Available vars:
- content: pre-rendered HTML content for the TOC
-->

<div class="toc">
    <h2>Table of Contents</h2>
    <div class="toc-contents">
        {{{content}}}
    </div>
</div>


<!-- jsreport page break. See https://jsreport.net/blog/pdf-report-paging-and-page-breaks -->
<div class="page-break"></div>
<!-- 
Template for a single operation parameter in the API section.
Available variables:

- name: string;
- in: string;
- required: boolean;
- description: string; // pre-rendered HTML
- schema: string; // pre-rendered schema
- type: string;
- isArray: boolean;
  
-->

<div class="operation-parameter">
    <div class="parameter-name">{{name}}</div>
    <div class="parameter-type">{{type}}</div>
    <div class="parameter-in">{{in}}</div>
    <div class="parameter-required">
        {{#if required}}
            required
        {{/if}}
    </div>
    <div class="parameter-description">
    {{#if description}}
        <!-- this is a preprocesed description in HTML -->
        <div class="parameter-description-label">{{{description}}}</div>
    {{/if}}
    {{#if schema}}
        {{#if isArray}}
            <div class="parameter-description-label-comment">Each item of the array:</div>
        {{/if}}
        <pre>{{schema}}</pre>
    {{/if}}
    </div>
</div>

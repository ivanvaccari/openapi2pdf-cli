<!-- 
Summary page template. USe this page to add any text or links you want to show at the beginning of the PDF.

Available variables:
- metadata: the full object from the "metadata" field in the config file
- openapiJsonPath: the path to the OpenAPI JSON file

This page is rendered after "revisions" and before "authentication" page.
-->

<div class='summary-page'>
    <h2>Summary</h2>
    <div class="server-info">
        
        {{#if metadata.servers?}}
            <b>Epi endpoints</b>: <br>
            {{#each metadata.servers}}
                 - {{this.url}}<br>
            {{/each}}
        {{/if}}

        {{#if metadata.swaggerUrl}}
            <b><a href='https://swagger.io/'>Swagger</a> UI</b>: {{metadata.swaggerUrl}}<br><br>
        {{/if}}

        
        <b><a href='https://swagger.io/specification/'>OpenAPI</a> JSON</b>: {{openapiJsonPath}}<br><br>
        
    </div>
</div>


<!-- jsreport page break. See https://jsreport.net/blog/pdf-report-paging-and-page-breaks -->
<div class="page-break"></div>
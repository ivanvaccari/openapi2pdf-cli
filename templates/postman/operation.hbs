<div class="operation">
    <div class="operation-header">
        <div class="operation-method {{method}}">{{method}}</div>
        <div class="operation-path">{{path}}</div>
    </div>
    {{#if operation.summary}}
        <div class="operation-summary">
            {{operation.summary}}
        </div>
    {{/if}}

    {{#if operation.description}}
        <div class="operation-description">
            <div>{{operation.description}}</div>
        </div>
    {{/if}}

    {{#if operation.parameters}}
        <h4>Parameters</h4>
        <div class="operation-parameters">
            <!-- this is a pre-rendered header for operation parameters -->
            {{{operation.parametersHeader}}}
            <!-- this is a pre-rendered block of operation parameters -->
            {{{operation.parameters}}}
        </div>
    {{/if}}

    {{#if operation.responses}}
        <h4>Responses</h4>
        <div class="operation-responses">
            <!-- this is a pre-rendered block of operation responses -->
            {{{operation.responses}}}
        </div>
    {{/if}}
</div>

